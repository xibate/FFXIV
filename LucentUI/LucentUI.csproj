<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.28.0.0</Version>
    <!-- Manifest fields picked up by DalamudPackager -->
    <Author>xibate</Author>
    <Name>LucentUI</Name>
    <Punchline>A clean, modern and modular HUD replacement.</Punchline>
    <Description>LucentUI replaces the default HUD with clean unit frames, party frames, job gauges for every job, cast bars, auras, party cooldowns, an enemy list, nameplates and more.
Everything can be moved in Unlock Mode, styled from one place, and saved into profiles that switch automatically per job. EllesmereUI profiles from WoW can be imported.
Inspired by EllesmereUI for World of Warcraft.</Description>
    <RepoUrl>https://github.com/xibate/FFXIV</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/xibate/FFXIV/claude/quirky-volta-q8y8hy/LucentUI/images/icon.png</IconUrl>
    <Tags>UI;HUD;unitframes;party;castbar;jobgauge;nameplates</Tags>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unpacks .7z and .rar media packs (zips use the framework's own reader). -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Config\Presets\Lucent.lui" LogicalName="LucentUI.Presets.Lucent.lui" />
    <!-- Plugin icon: Dalamud shows images/icon.png next to the plugin; the repository lists it by IconUrl. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
